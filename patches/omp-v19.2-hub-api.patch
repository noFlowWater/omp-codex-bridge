index 0000000..0d7bc22
--- /dev/null
+++ b/packages/coding-agent/src/modes/extension-agents.ts
@@ -0,0 +1,227 @@
+import * as path from "node:path";
+import { Snowflake } from "@oh-my-pi/pi-utils";
+import type { AsyncJob, AsyncJobManagerApi } from "../async/job-manager";
+import type { ExtensionAgentHandle, ExtensionAgentJob, ExtensionAgentsAPI } from "../extensibility/extensions/types";
+import type { AgentLifecycleApi } from "../registry/agent-lifecycle";
+import { MAIN_AGENT_ID, type AgentRef, type AgentRegistryApi } from "../registry/agent-registry";
+import { sessionFileBelongsToRoot } from "../registry/persisted-agents";
+import type { AgentSessionHandle } from "../session/agent-session-handle";
+import type { SessionManager } from "../session/session-manager";
+import type { TaskTool } from "../task";
+
+interface OwnerSession {
+	readonly sessionManager: Pick<
+		SessionManager,
+		"getSessionFile" | "getSessionId" | "getCwd" | "ensureOnDisk" | "flush"
+	>;
+	readonly asyncJobManager: AsyncJobManagerApi | undefined;
+	getAgentId(): string | undefined;
+	getEnabledToolNames(): string[];
+	hasBuiltInTool(name: string): boolean;
+	getToolByName(name: string): unknown;
+}
+
+/** Native tool wrappers forward public methods while retaining SDK source provenance. */
+function hasNativeSpawn(tool: unknown): tool is Pick<TaskTool, "spawnForExtension"> {
+	return (
+		typeof tool === "object" &&
+		tool !== null &&
+		"spawnForExtension" in tool &&
+		typeof tool.spawnForExtension === "function"
+	);
+}
+
+/** A host-owned facade: extensions never receive registry, lifecycle or raw child sessions. */
+export function createExtensionAgents(options: {
+	session: OwnerSession;
+	getCurrentSession(): OwnerSession;
+	registry: AgentRegistryApi;
+	lifecycle: AgentLifecycleApi;
+	focusAgent(id: string, expected: { sessionFile: string | null; generation: number }): Promise<void>;
+}): ExtensionAgentsAPI {
+	const { session, registry, lifecycle } = options;
+	const ownerId = session.getAgentId() ?? MAIN_AGENT_ID;
+	let rootFile = session.sessionManager.getSessionFile();
+	const rootId = session.sessionManager.getSessionId();
+	const manager = session.asyncJobManager;
+	const assertOwner = (): void => {
+		if (options.getCurrentSession() !== session || session.sessionManager.getSessionId() !== rootId) {
+			throw new Error("Agent Hub context belongs to an earlier session; reopen the command.");
+		}
+	};
+	const isOwned = (job: AsyncJob): boolean => {
+		if (!job.agentId || job.type !== "task") return false;
+		const ref = registry.get(job.agentId);
+		if (
+			ref &&
+			(ref.kind !== "sub" || !rootFile || !ref.sessionFile || !sessionFileBelongsToRoot(ref.sessionFile, rootFile))
+		)
+			return false;
+		const seen = new Set<string>();
+		// Root sessions own distinct managers; queued jobs already carry their native owner and agent ids.
+		let parent = ref?.parentId ?? job.ownerId;
+		while (parent && !seen.has(parent)) {
+			if (parent === ownerId) return true;
+			seen.add(parent);
+			const ancestor = registry.get(parent);
+			if (!ancestor?.sessionFile || !rootFile || !sessionFileBelongsToRoot(ancestor.sessionFile, rootFile))
+				return false;
+			parent = ancestor.parentId;
+		}
+		return false;
+	};
+	const snapshot = (job: AsyncJob): ExtensionAgentJob => {
+		const ref = job.agentId ? registry.get(job.agentId) : undefined;
+		const live = ref?.session;
+		return {
+			agentId: job.agentId!,
+			jobId: job.id,
+			jobStartedAt: job.startTime,
+			runStartedAt: live?.runStartedAt,
+			sessionFile: ref?.sessionFile ?? null,
+			sessionId: live?.sessionManager.getSessionId(),
+			generation: ref?.generation,
+			name: job.label || ref?.displayName || job.agentId!,
+			status: job.status,
+			agentStatus: ref?.status,
+			cwd: live?.sessionManager.getCwd() ?? session.sessionManager.getCwd(),
+			model: live?.model ? `${live.model.provider}/${live.model.id}` : ref?.history?.resolvedModel,
+			lastActivity: ref?.lastActivity ?? job.endTime ?? job.startTime,
+			error: job.errorText,
+		};
+	};
+	const assertHandle = (handle: ExtensionAgentHandle): { job: AsyncJob; ref: AgentRef | undefined } => {
+		assertOwner();
+		const job = manager?.getJob(handle.jobId);
+		const latest = manager
+			?.getAllJobs()
+			.filter(row => row.agentId === handle.agentId)
+			.at(-1);
+		const ref = registry.get(handle.agentId);
+		if (
+			!job ||
+			!isOwned(job) ||
+			job.agentId !== handle.agentId ||
+			job.startTime !== handle.jobStartedAt ||
+			latest !== job
+		) {
+			throw new Error("Agent Hub selection is stale or outside this session; refresh the job list.");
+		}
+		if (
+			(ref?.sessionFile ?? null) !== handle.sessionFile ||
+			ref?.generation !== handle.generation ||
+			ref?.session?.runStartedAt !== handle.runStartedAt ||
+			(handle.sessionId !== undefined && ref?.session?.sessionManager.getSessionId() !== handle.sessionId)
+		) {
+			throw new Error("Agent Hub child session changed; refresh the job list.");
+		}
+		return { job, ref };
+	};
+	const liveFor = async (handle: ExtensionAgentHandle): Promise<AgentSessionHandle> => {
+		const { ref } = assertHandle(handle);
+		if (!ref?.sessionFile) throw new Error("Agent Hub child has not started; refresh the job list.");
+		const live = await lifecycle.ensureLive(ref.id);
+		assertOwner();
+		const current = registry.get(ref.id);
+		if (current !== ref || current?.session !== live || current.sessionFile !== ref.sessionFile) {
+			throw new Error("Agent Hub child was replaced while opening; refresh the job list.");
+		}
+		assertHandle(handle);
+		return live;
+	};
+	return {
+		list: () => {
+			assertOwner();
+			return manager?.getAllJobs().filter(isOwned).map(snapshot) ?? [];
+		},
+		spawn: async request => {
+			assertOwner();
+			if (!manager) throw new Error("Agent Hub children require async jobs.");
+			if (!request.agent.trim() || !request.task.trim()) throw new Error("Agent and task must be non-empty.");
+			if (
+				request.cwd !== undefined &&
+				(!path.isAbsolute(request.cwd) ||
+					path.resolve(request.cwd) !== path.resolve(session.sessionManager.getCwd()))
+			) {
+				throw new Error("Child source cwd must match the current workspace; open that workspace first.");
+			}
+			const initialization = structuredClone(request.initialization ?? []);
+			for (const entry of initialization) {
+				if (!entry.customType?.trim()) throw new Error("Child initialization needs a non-empty customType.");
+			}
+			const tool = session.getToolByName("task");
+			if (
+				!session.getEnabledToolNames().includes("task") ||
+				!session.hasBuiltInTool("task") ||
+				!hasNativeSpawn(tool)
+			) {
+				throw new Error("Agent Hub spawn requires the enabled native task tool.");
+			}
+			await session.sessionManager.ensureOnDisk();
+			await session.sessionManager.flush();
+			assertOwner();
+			rootFile = session.sessionManager.getSessionFile();
+			if (!rootFile) throw new Error("Agent Hub children require a persisted session; --no-session is unsupported.");
+			const result = await tool.spawnForExtension(`extension-${Snowflake.next()}`, { ...request, initialization });
+			assertOwner();
+			const id = result.details?.async?.jobId;
+			const job = id ? manager.getJob(id) : undefined;
+			if (!job || result.isError)
+				throw new Error(result.content.find(part => part.type === "text")?.text ?? "Native child spawn failed.");
+			return snapshot(job);
+		},
+		focus: async handle => {
+			await liveFor(handle);
+			const { ref } = assertHandle(handle);
+			await options.focusAgent(handle.agentId, { sessionFile: ref!.sessionFile, generation: ref!.generation });
+		},
+		send: async (handle, message, sendOptions) => {
+			const { job: previous, ref: selectedRef } = assertHandle(handle);
+			if (!message.trim()) throw new Error("Child message must be non-empty.");
+			if (!handle.sessionFile) throw new Error("Agent Hub child has not started; refresh the job list.");
+			const live = await liveFor(handle);
+			const id = manager!.register(
+				"task",
+				message,
+				async ({ signal, jobId }) => {
+					manager!.acknowledgeDeliveries([jobId]);
+					assertOwner();
+					if (registry.get(handle.agentId) !== selectedRef)
+						throw new Error("Child generation changed before delivery.");
+					const ref = registry.get(handle.agentId);
+					if (
+						signal.aborted ||
+						ref !== selectedRef ||
+						ref?.session !== live ||
+						ref.sessionFile !== handle.sessionFile ||
+						live.runStartedAt !== handle.runStartedAt
+					) {
+						throw new Error("Child changed or follow-up was cancelled before delivery.");
+					}
+					const abort = () => {
+						void live.abort({ reason: "User interrupted" });
+					};
+					signal.addEventListener("abort", abort, { once: true });
+					try {
+						await live.prompt(message, { streamingBehavior: sendOptions?.streamingBehavior ?? "steer" });
+						return "Child input delivered.";
+					} finally {
+						signal.removeEventListener("abort", abort);
+					}
+				},
+				{ agentId: handle.agentId, ownerId: previous.ownerId },
+			);
+			return snapshot(manager!.getJob(id)!);
+		},
+		interrupt: async handle => {
+			const { ref } = assertHandle(handle);
+			if (!ref?.session) throw new Error("Child has no live operation to interrupt.");
+			await ref.session.abort({ reason: "User interrupted" });
+		},
+		cancel: async handle => {
+			const { job, ref } = assertHandle(handle);
+			if (ref) await lifecycle.release(ref.id, ref, { tombstone: true });
+			manager!.cancel(job.id, { ownerId: job.ownerId });
+		},
+	};
+}
